export_tables <- function(
    tables,
    titles = NULL,
    path = "migration_model_results.docx") {

  stopifnot(length(tables) >= 1)

  if (is.null(titles)) {
    titles <- paste0("Table ", seq_along(tables))
  }

  if (length(titles) != length(tables)) {
    stop("The number of table titles must equal the number of tables.")
  }

  named_tables <- setNames(tables, titles)
  args <- c(named_tables, list(path = path))
  do.call(flextable::save_as_docx, args)

  message("Saved Word file: ", normalizePath(path))
  invisible(path)
}

results_flextable <- function(
    models,
    coef_keep,
    coef_labels = NULL,
    cluster_formula = ~orig_dest_dyad,
    header_title = "Model results") {

  if (length(models) == 0) {
    stop("No successfully estimated models were supplied.")
  }

  if (is.null(names(models))) {
    names(models) <- paste0("Model ", seq_along(models))
  }

  coef_map <- setNames(coef_keep, coef_keep)

  if (!is.null(coef_labels)) {
    matched <- intersect(names(coef_labels), coef_keep)
    coef_map[matched] <- coef_labels[matched]
  }

  ft <- modelsummary::modelsummary(
    models,
    output = "flextable",
    vcov = cluster_formula,
    estimate = "{estimate}{stars} ({std.error})",
    statistic = NULL,
    coef_keep = coef_keep,
    coef_map = coef_map,
    gof_omit = ".*",
    stars = c("*" = 0.10, "**" = 0.05, "***" = 0.01),
    fmt = 3
  )

  keys <- ft$col_keys
  term_col <- keys[1]
  model_cols <- setdiff(keys, term_col)

  # Fixed-effects block
  fe_labels <- c("Time fixed effects", "Origin fixed effects", "Destination fixed effects")
  fe_vars <- c("time", "origin", "destination")

  fe_rows <- as.data.frame(
    matrix("", nrow = length(fe_vars), ncol = length(keys)),
    stringsAsFactors = FALSE
  )
  names(fe_rows) <- keys
  fe_rows[[term_col]] <- fe_labels

  has_fixed_effect <- function(model, fixed_effect) {
    fe_names <- tryCatch(
      names(fixest::fixef(model)),
      error = function(e) character(0)
    )
    fixed_effect %in% fe_names
  }

  for (model_name in names(models)) {
    if (!(model_name %in% model_cols)) {
      next
    }

    fe_rows[[model_name]] <- vapply(
      fe_vars,
      function(fe) if (has_fixed_effect(models[[model_name]], fe)) "Yes" else "No",
      character(1)
    )
  }

  for (i in seq_len(nrow(fe_rows))) {
    ft <- flextable::add_body_row(
      ft,
      values = as.list(fe_rows[i, ]),
      top = FALSE
    )
  }

  # Goodness-of-fit block
  format_number <- function(x, digits = 3) {
    ifelse(
      is.na(x),
      "",
      formatC(x, format = "f", digits = digits)
    )
  }

  gof_labels <- c(
    "Standard errors",
    "Observations",
    "Squared correlation",
    "Pseudo-R²",
    "BIC"
  )

  gof_rows <- as.data.frame(
    matrix("", nrow = length(gof_labels), ncol = length(keys)),
    stringsAsFactors = FALSE
  )
  names(gof_rows) <- keys
  gof_rows[[term_col]] <- gof_labels

  for (model_name in names(models)) {
    if (!(model_name %in% model_cols)) {
      next
    }

    model <- models[[model_name]]

    n <- tryCatch(stats::nobs(model), error = function(e) NA_real_)
    sq_cor <- tryCatch(
      as.numeric(fixest::fitstat(model, "sq.cor")),
      error = function(e) NA_real_
    )
    pseudo_r2 <- tryCatch(
      as.numeric(fixest::fitstat(model, "pr2")),
      error = function(e) NA_real_
    )
    bic <- tryCatch(
      as.numeric(fixest::fitstat(model, "bic")),
      error = function(e) NA_real_
    )

    if (is.na(bic)) {
      bic <- tryCatch(
        as.numeric(stats::BIC(model)),
        error = function(e) NA_real_
      )
    }

    gof_rows[gof_rows[[term_col]] == "Standard errors", model_name] <-
      "Dyad-clustered"
    gof_rows[gof_rows[[term_col]] == "Observations", model_name] <-
      ifelse(is.na(n), "", format(n, big.mark = ","))
    gof_rows[gof_rows[[term_col]] == "Squared correlation", model_name] <-
      format_number(sq_cor, 3)
    gof_rows[gof_rows[[term_col]] == "Pseudo-R²", model_name] <-
      format_number(pseudo_r2, 3)
    gof_rows[gof_rows[[term_col]] == "BIC", model_name] <-
      format_number(bic, 1)
  }

  for (i in seq_len(nrow(gof_rows))) {
    ft <- flextable::add_body_row(
      ft,
      values = as.list(gof_rows[i, ]),
      top = FALSE
    )
  }

  # Title row
  ft <- flextable::add_header_row(
    ft,
    values = header_title,
    colwidths = length(keys)
  )

  # Formatting
  ft <- flextable::autofit(ft)
  ft <- flextable::width(ft, j = 1, width = 2.2)

  if (length(keys) >= 2) {
    ft <- flextable::width(ft, j = 2:length(keys), width = 0.9)
  }

  ft <- flextable::font(ft, fontname = "Times New Roman", part = "all")
  ft <- flextable::fontsize(ft, size = 9, part = "all")
  ft <- flextable::bold(ft, bold = TRUE, part = "header")
  ft <- flextable::align(ft, align = "center", part = "header")
  ft <- flextable::align(ft, j = 1, align = "left", part = "body")

  if (length(keys) >= 2) {
    ft <- flextable::align(
      ft,
      j = 2:length(keys),
      align = "center",
      part = "body"
    )
  }

  ft <- flextable::height_all(ft, height = 0.42)
  ft <- flextable::padding(ft, padding.top = 1, padding.bottom = 1)
  ft <- flextable::border_remove(ft)

  border <- officer::fp_border(color = "black", width = 1)
  ft <- flextable::hline_top(ft, part = "header", border = border)
  ft <- flextable::hline_bottom(ft, part = "header", border = border)

  time_row <- which(ft$body$dataset[[term_col]] == "Time fixed effects")
  observations_row <- which(ft$body$dataset[[term_col]] == "Observations")

  if (length(time_row) == 1 && time_row > 1) {
    ft <- flextable::hline(
      ft,
      i = time_row - 1,
      part = "body",
      border = border
    )
  }

  if (length(observations_row) == 1 && observations_row > 1) {
    ft <- flextable::hline(
      ft,
      i = observations_row - 1,
      part = "body",
      border = border
    )
  }

  flextable::hline_bottom(ft, part = "body", border = border)
}

