mk_header_labels <- function(models) {
  model_names <- names(models)
  if (is.null(model_names)) model_names <- paste0("Model ", seq_along(models))
  pretty_map <- c(
    "(0)" = "(0) All flows",
    "(1)" = "(1) Risk reduction",
    "(2)" = "(2) Risk increase"
  )
  header_labels <- ifelse(model_names %in% names(pretty_map),
                          pretty_map[model_names],
                          model_names)
  setNames(header_labels, model_names)
}


