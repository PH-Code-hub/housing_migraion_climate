make_formula <- function(
    outcome,
    rhs_vars,
    fixed_effects = c("origin", "destination", "time")) {

  if (length(rhs_vars) == 0) {
    stop("At least one explanatory variable is required.")
  }

  allowed_fe <- c("origin", "destination", "time")
  fixed_effects <- intersect(fixed_effects, allowed_fe)

  if (length(fixed_effects) == 0) {
    stop("At least one fixed effect is required.")
  }

  as.formula(
    sprintf(
      "%s ~ %s | %s",
      outcome,
      paste(rhs_vars, collapse = " + "),
      paste(fixed_effects, collapse = " + ")
    )
  )
}

estimate_panel_models <- function(
    data,
    outcome,
    rhs_vars,
    fixed_effects = c("origin", "destination", "time"),
    family = c("ppml", "ols"),
    panel_type = c("risk_change", "risk_context", "all")) {

  family <- match.arg(family)
  panel_type <- match.arg(panel_type)

  require_variables(
    data,
    c(outcome, rhs_vars, fixed_effects),
    "Model"
  )

  formula <- make_formula(outcome, rhs_vars, fixed_effects)
  estimator <- if (family == "ppml") fixest::fepois else fixest::feols

  if (panel_type == "all") {
    panels <- list("(0) All flows" = data)

  } else if (panel_type == "risk_change") {
    require_variables(data, "risk_dif_q", "Risk-change split")

    risk_change <- trimws(as.character(data$risk_dif_q))

    panels <- list(
      "(0) All flows" = data,
      "(1) Risk reduction" = data[
        !is.na(risk_change) &
          risk_change %in% c("Neg High", "Neg Low"),
        ,
        drop = FALSE
      ],
      "(2) Risk increase" = data[
        !is.na(risk_change) &
          risk_change %in% c("Pos Low", "Pos High"),
        ,
        drop = FALSE
      ]
    )

  } else {
    require_variables(
      data,
      c("total_risk_q", "total_risk_des_q"),
      "Risk-context split"
    )

    origin_risk <- trimws(as.character(data$total_risk_q))
    destination_risk <- trimws(as.character(data$total_risk_des_q))

    panels <- list(
      "(0) All flows" = data,
      "(1) High-risk origin" = data[
        !is.na(origin_risk) & origin_risk == "5",
        ,
        drop = FALSE
      ],
      "(2) Low-risk origin" = data[
        !is.na(origin_risk) & origin_risk == "1",
        ,
        drop = FALSE
      ],
      "(3) Low-risk destination" = data[
        !is.na(destination_risk) & destination_risk == "1",
        ,
        drop = FALSE
      ],
      "(4) High-risk destination" = data[
        !is.na(destination_risk) & destination_risk == "5",
        ,
        drop = FALSE
      ]
    )
  }

  fitted_models <- lapply(panels, function(panel_data) {
    if (is.null(panel_data) || nrow(panel_data) == 0) {
      return(NULL)
    }

    tryCatch(
      estimator(formula, data = panel_data),
      error = function(e) {
        message("Model failed: ", conditionMessage(e))
        NULL
      }
    )
  })

  Filter(Negate(is.null), fitted_models)
}

