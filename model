mk_form <- function(y, rhs_vars, fe = c("origin","destination","time")) {
  stopifnot(length(rhs_vars) >= 1)
  rhs <- paste(rhs_vars, collapse = " + ")
  fe_spec <- paste(intersect(fe, c("origin","destination","time")), collapse = " + ")
  as.formula(sprintf("%s ~ %s | %s", y, rhs, fe_spec))
}

fit_models <- function(data, y, rhs_vars,
                       fe = c("origin","destination","time"),
                       split_col = "risk_dif_q",
                       family = c("ppml","ols")) {
  family <- match.arg(family)
  form   <- mk_form(y, rhs_vars, fe)
  fitfun <- if (family == "ppml") fixest::fepois else fixest::feols
  
  # handle split
  if (is.null(split_col)) {
    panels <- list("(0)" = data)
  } else {
    if (!(split_col %in% names(data))) {
      stop(sprintf("split_col '%s' not found in data", split_col))
    }
    x_chr <- trimws(as.character(data[[split_col]]))
    is_reduction <- !is.na(x_chr) & x_chr %in% c("Neg High","Neg Low")
    is_increase  <- !is.na(x_chr) & x_chr %in% c("Pos Low","Pos High")
    panels <- list(
      "(0)\nAll flows"   = data,
      "(1)\nrisk reduction" = data[is_reduction, , drop = FALSE],
      "(2)\nrisk increase"  = data[is_increase,  , drop = FALSE]
    )
  }
  
  fits <- lapply(panels, function(dsub) {
    if (is.null(dsub) || nrow(dsub) == 0) return(NULL)
    tryCatch(fitfun(form, data = dsub),
             error = function(e) { message("Model failed: ", conditionMessage(e)); NULL })
  })
  Filter(Negate(is.null), fits)
}

fit_models_des <- function(data, y, rhs_vars, fe = c("origin","destination","time"),
                           split_col_1 = "total_risk_q",split_col_2 = "total_risk_des_q", family = c("ppml","ols")) {
  
  family <- match.arg(family)
  form   <- mk_form(y, rhs_vars, fe)
  fitfun <- if (family == "ppml") fixest::fepois else fixest::feols
  
  x <- as.character(data[[split_col_1]])
  y <- as.character(data[[split_col_2]])
  # Map panels: (0) duplicates (1) by request
  panels <- list(
    "(0)\nAll flows" = data,
    "(1)\nHigh-risk Origin" = data[!is.na(x) & x == 5, , drop = FALSE],
    "(2)\nLow-risk Origin" = data[!is.na(x) & x == 1, , drop = FALSE],
    "(3)\nLow-risk Destination" = data[!is.na(x) & y == 1, , drop = FALSE],
    "(4)\nHigh-risk Destination" = data[!is.na(x) & y == 5, , drop = FALSE]
  )
  
  out <- lapply(panels, function(dsub) {
    if (nrow(dsub) > 0) fitfun(form, data = dsub) else NULL
  })
  
  # drop NULLs but keep order/names for the ones that exist
  out <- Filter(Negate(is.null), out)
  out
}


