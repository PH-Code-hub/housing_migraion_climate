export_ppml_tables <- function(tables, titles = NULL, path = "PPML_results_table.docx") {
  stopifnot(length(tables) >= 1)
  if (is.null(titles)) titles <- paste0("Table ", seq_along(tables))
  stopifnot(length(titles) == length(tables))
  named_list <- setNames(tables, titles)
  args <- c(named_list, list(path = path))
  do.call(flextable::save_as_docx, args)
  message("Saved Word file: ", normalizePath(path))
  invisible(path)
}

ppml_flextable <- function(models,
                           coef_keep,
                           coef_labels = NULL,
                           cluster_formula = ~ orig_dest_dyad,
                           header_title = "Model results",
                           header_labels = NULL) {
  
  stopifnot(length(models) >= 1)
  if (is.null(names(models))) names(models) <- paste0("Model ", seq_along(models))
  
  coef_map <- setNames(coef_keep, coef_keep)
  if (!is.null(coef_labels)) {
    ov <- intersect(names(coef_labels), coef_keep)
    coef_map[ov] <- coef_labels[ov]
  }
  
  ft <- modelsummary::modelsummary(
    models,
    output        = "flextable",
    vcov          = cluster_formula,
    estimate      = "{estimate}{stars} ({std.error})",
    statistic     = NULL,
    coef_keep     = coef_keep,
    coef_map      = coef_map,
    gof_omit      = ".*",
    stars         = c("*"=.10, "**"=.05, "***"=.01),
    fmt           = 3
  )
  
  keys <- ft$col_keys
  term_col   <- keys[1]
  model_cols <- setdiff(keys, term_col)
  
  if (!is.null(header_labels)) {
    map <- header_labels[names(header_labels) %in% model_cols]
    if (length(map)) {
      ft <- flextable::set_header_labels(ft, .list = as.list(map))
    }
  }
  
  # ---------- FE block ----------
  fe_labels <- c("Time FE","Origin FE","Destination FE")
  fe_vars   <- c("time","origin","destination")
  fe_mat <- as.data.frame(matrix("", nrow = length(fe_vars), ncol = length(keys)), stringsAsFactors = FALSE)
  names(fe_mat) <- keys
  fe_mat[[term_col]] <- fe_labels
  
  has_fe <- function(m, fe) {
    fe_list <- tryCatch(names(fixest::fixef(m)), error = function(e) character(0))
    fe %in% fe_list
  }
  for (mc in names(models)) {
    if (!(mc %in% model_cols)) next
    m <- models[[mc]]
    fe_mat[[mc]] <- vapply(fe_vars, function(fe) if (has_fe(m, fe)) "x" else "", character(1))
  }
  for (i in seq_len(nrow(fe_mat))) {
    ft <- flextable::add_body_row(ft, values = as.list(fe_mat[i, ]), top = FALSE)
  }
  
  # ---------- GOF block ----------
  fmt_num <- function(x, digits = 3) ifelse(is.na(x), "", formatC(x, format="f", digits=digits))
  gof_names <- c("S.E.: Clustered","Observations","Squared Cor.","Pseudo R2","BIC")
  gof_mat <- as.data.frame(matrix("", nrow = length(gof_names), ncol = length(keys)), stringsAsFactors = FALSE)
  names(gof_mat) <- keys
  gof_mat[[term_col]] <- gof_names
  
  for (mc in names(models)) {
    if (!(mc %in% model_cols)) next
    m <- models[[mc]]
    gof_mat[gof_mat[[term_col]]=="S.E.: Clustered", mc] <- "orig_dest_dyad"
    n    <- tryCatch(stats::nobs(m), error = function(e) NA_real_)
    sqcor<- tryCatch(as.numeric(fixest::fitstat(m, "sq.cor")), error = function(e) NA_real_)
    pr2  <- tryCatch(as.numeric(fixest::fitstat(m, "pr2")),    error = function(e) NA_real_)
    bic  <- tryCatch(as.numeric(fixest::fitstat(m, "bic")),    error = function(e) NA_real_)
    if (is.na(bic)) bic <- tryCatch(as.numeric(stats::BIC(m)), error = function(e) NA_real_)
    
    gof_mat[gof_mat[[term_col]]=="Observations", mc] <- ifelse(is.na(n), "", format(n, big.mark=","))
    gof_mat[gof_mat[[term_col]]=="Squared Cor.", mc] <- fmt_num(sqcor, 3)
    gof_mat[gof_mat[[term_col]]=="Pseudo R2",   mc] <- fmt_num(pr2,   3)
    gof_mat[gof_mat[[term_col]]=="BIC",         mc] <- fmt_num(bic,   1)
  }
  for (i in seq_len(nrow(gof_mat))) {
    ft <- flextable::add_body_row(ft, values = as.list(gof_mat[i, ]), top = FALSE)
  }
  
  # ---------- Add Header 1 (title) ----------
  k <- length(keys)
  ft <- flextable::add_header_row(ft, values = header_title, colwidths = k)
  
  # ---------- Format ----------
  ft <- flextable::autofit(ft)
  ncols <- length(keys)
  ft <- flextable::width(ft, j = 1, width = 2)
  if (ncols >= 2) ft <- flextable::width(ft, j = 2:ncols, width = 0.8)
  ft <- flextable::font(ft, fontname = "Times New Roman", part = "all")
  ft <- flextable::fontsize(ft, part = "all", size = 9)
  ft <- flextable::bold(ft, part = "header", bold = TRUE)
  ft <- flextable::align(ft, i = 1, align = "center", part = "header")
  ft <- flextable::align(ft, j = 1, align = "left",  part = "body")
  if (ncols >= 2) ft <- flextable::align(ft, j = 2:ncols, align = "center", part = "body")
  ft <- flextable::height_all(ft, height = 0.45)
  ft <- flextable::padding(ft, padding.top = 1, padding.bottom = 1)
  
  ft <- flextable::border_remove(ft)
  b  <- officer::fp_border(color = "black", width = 1)
  ft <- flextable::hline_top(ft, part = "header", border = b)
  ft <- flextable::hline(ft, i = 1, part = "header", border = b)
  ft <- flextable::hline_bottom(ft, part = "header", border = b)
  
  i_time <- which(ft$body$dataset[[term_col]] == "Time FE")
  i_obs  <- which(ft$body$dataset[[term_col]] == "Observations")
  if (length(i_time) && i_time > 1) ft <- flextable::hline(ft, i = i_time - 1, part = "body", border = b)
  if (length(i_obs)  && i_obs  > 1) ft <- flextable::hline(ft, i = i_obs  - 1, part = "body", border = b)
  ft <- flextable::hline_bottom(ft, part = "body", border = b)
  
  ft
}

