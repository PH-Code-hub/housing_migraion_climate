print_price_interaction_cov <- function(models,
                                        beta_origin, gamma_origin,
                                        beta_dest,   gamma_dest,
                                        cluster = ~orig_dest_dyad) {
  
  cat("\n=================================================\n")
  cat("Covariance extraction (PPML, dyad-clustered)\n")
  cat("=================================================\n")
  
  for (mn in names(models)) {
    m <- models[[mn]]
    
    cat("\n-----------------------------------------------\n")
    cat("Model:", gsub("\n", " — ", mn), "\n")
    
    # Use S3 generics (fixest methods will dispatch)
    V  <- stats::vcov(m, cluster = cluster)
    cf <- stats::coef(m)
    
    extract_one <- function(beta, gamma, label) {
      cat("\n", label, "\n", sep = "")
      
      if (!(beta %in% names(cf)) || !(gamma %in% names(cf))) {
        cat("  Term(s) not estimated in this subsample\n")
        return()
      }
      
      cat("  beta  =", unname(cf[beta]), "\n")
      cat("  se(b) =", sqrt(V[beta, beta]), "\n")
      cat("  gamma =", unname(cf[gamma]), "\n")
      cat("  se(g) =", sqrt(V[gamma, gamma]), "\n")
      cat("  Cov(beta, gamma) =", V[beta, gamma], "\n")
    }
    
    extract_one(beta_origin, gamma_origin, "Origin price interaction")
    extract_one(beta_dest,   gamma_dest,   "Destination price interaction")
  }
}


