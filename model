prepare_data <- function(data) {
  required_ids <- c(
    "origin",
    "destination",
    "orig_dest_dyad",
    "time"
  )
  require_variables(data, required_ids, "Data preparation")

  for (variable in required_ids) {
    data[[variable]] <- factor(data[[variable]])
  }

  for (variable in c("contiguity", "interstate", "bass_strait")) {
    if (!(variable %in% names(data))) {
      data[[variable]] <- 0
    }
  }

  if ("distance" %in% names(data)) {
    data$distance <- pmax(data$distance, 1e-6)
  }

  # Construct risk-change categories only when absent.
  if (!("risk_dif_q" %in% names(data)) && "risk_dif" %in% names(data)) {
    breaks <- unique(
      quantile(
        data$risk_dif,
        probs = seq(0, 1, 0.25),
        na.rm = TRUE
      )
    )

    if (length(breaks) == 5) {
      data$risk_dif_q <- cut(
        data$risk_dif,
        breaks = breaks,
        include.lowest = TRUE,
        labels = c("Neg High", "Neg Low", "Pos Low", "Pos High")
      )
    } else {
      warning(
        "risk_dif_q was not created because quantile break points were not unique."
      )
    }
  }

  log_variables <- c(
    # Housing and socioeconomic variables
    "price_ave", "price_ave_des",
    "price_ave_5_yr", "price_ave_5_yr_des",
    "price_ave_lead_5_yr", "price_ave_lead_5_yr_des",
    "price", "price_des",
    "price_5_yr", "price_5_yr_des",
    "price_lead_5_yr", "price_lead_5_yr_des",
    "rent", "rent_des",
    "rent_5_yr", "rent_5_yr_des",
    "mort", "mort_des",
    "mort_5_yr", "mort_5_yr_des",
    "income", "income_des",
    "income_5_yr", "income_5_yr_des",
    "unemp", "unemp_des",
    "unemp_5_yr", "unemp_5_yr_des",
    "lfpr", "lfpr_des",
    "lfpr_5_yr", "lfpr_5_yr_des",
    "pop", "pop_des",
    "pop_5_yr", "pop_5_yr_des",
    "biz_total", "biz_total_des",
    "biz_total_5_yr", "biz_total_5_yr_des",
    "GRP", "GRP_des",
    "raff", "raff_des",
    "raff_5_yr", "raff_5_yr_des",
    "oaff", "oaff_des",
    "oaff_5_yr", "oaff_5_yr_des",
    "distance",

    # Neighbouring areas
    "nei_GRP", "nei_GRP_des",
    "nei_income", "nei_income_des",
    "nei_income_5_yr", "nei_income_5_yr_des",
    "nei_unemp", "nei_unemp_des",
    "nei_unemp_5_yr", "nei_unemp_5_yr_des",
    "nei_lfpr", "nei_lfpr_des",
    "nei_lfpr_5_yr", "nei_lfpr_5_yr_des",
    "nei_biz_total", "nei_biz_total_des",
    "nei_biz_total_5_yr", "nei_biz_total_5_yr_des",
    "nei_rent", "nei_rent_des",
    "nei_rent_5_yr", "nei_rent_5_yr_des",
    "nei_mort", "nei_mort_des",
    "nei_mort_5_yr", "nei_mort_5_yr_des",
    "nei_raff", "nei_raff_des",
    "nei_raff_5_yr", "nei_raff_5_yr_des",
    "nei_oaff", "nei_oaff_des",
    "nei_oaff_5_yr", "nei_oaff_5_yr_des"
  )

  log1p_variables <- c(
    "dis_1_yr", "dis_1_yr_des",
    "dis_5_yr", "dis_5_yr_des",
    "dis_10_yr", "dis_10_yr_des",
    "nei_dis_1_yr", "nei_dis_1_yr_des",
    "nei_dis_5_yr", "nei_dis_5_yr_des",
    "nei_dis_10_yr", "nei_dis_10_yr_des",
    "med_edu_1yr_score", "med_edu_5yr_score",
    "med_emp_1yr_score", "med_emp_5yr_score",
    "med_inc_1yr_score", "med_inc_5yr_score"
  )

  for (variable in intersect(log_variables, names(data))) {
    data[[variable]] <- safe_log(data[[variable]])
  }

  for (variable in intersect(log1p_variables, names(data))) {
    data[[variable]] <- safe_log1p(data[[variable]])
  }

  data
}

