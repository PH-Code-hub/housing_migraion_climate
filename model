)

diagnostic_variables <- intersect(diagnostic_variables, names(df))
diagnostic_data <- df[, diagnostic_variables, drop = FALSE]

if (ncol(diagnostic_data) >= 2) {
  correlation_matrix <- cor(
    diagnostic_data,
    use = "pairwise.complete.obs"
  )

  correlation_long <- as.data.frame(
    as.table(correlation_matrix),
    stringsAsFactors = FALSE
  )

  names(correlation_long) <- c("variable_1", "variable_2", "correlation")

  top_correlations <- correlation_long |>
    filter(variable_1 != variable_2) |>
    mutate(pair = map2_chr(
      as.character(variable_1),
      as.character(variable_2),
      ~paste(sort(c(.x, .y)), collapse = " | ")
    )) |>
    distinct(pair, .keep_all = TRUE) |>
    arrange(desc(abs(correlation)))

  print(head(top_correlations, 30))
}

# VIF is a diagnostic approximation and does not reproduce the PPML FE model.
vif_variables <- intersect(
  c("annual_flow", diagnostic_variables),
  names(df)
)

vif_data <- df[, vif_variables, drop = FALSE]

if ("annual_flow" %in% names(vif_data) && ncol(vif_data) >= 3) {
  vif_model <- tryCatch(
    lm(annual_flow ~ ., data = vif_data),
    error = function(e) {
      message("VIF model was not estimated: ", conditionMessage(e))
      NULL
    }
  )

  if (!is.null(vif_model)) {
    vif_values <- car::vif(vif_model)

    if (is.matrix(vif_values)) {
      vif_results <- data.frame(
        variable = rownames(vif_values),
        GVIF = vif_values[, "GVIF"],
        adjusted_GVIF = vif_values[, "GVIF^(1/(2*Df))"],
        row.names = NULL
      ) |>
        arrange(desc(adjusted_GVIF))
    } else {
      vif_results <- data.frame(
        variable = names(vif_values),
        VIF = as.numeric(vif_values),
        row.names = NULL
      ) |>
        arrange(desc(VIF))
    }

    print(vif_results)
  }
}

