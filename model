prep_df <- function(d) {
  need_cols <- c("origin","destination","orig_dest_dyad")
  miss <- setdiff(need_cols, names(d))
  if (length(miss)) stop("Missing required column(s): ", paste(miss, collapse = ", "))
  
  for (nm in c("origin","destination","orig_dest_dyad","time")) if (nm %in% names(d)) d[[nm]] <- factor(d[[nm]])
  for (nm in c("contiguity","interstate","bass_strait")) if (!nm %in% names(d)) d[[nm]] <- 0
  
  # Guard distance for log()
  if ("distance" %in% names(d)) d$distance <- pmax(d$distance, 1e-6)
  
  # Create risk_dif_q if missing (signed quartiles)
  if (!"risk_dif_q" %in% names(d) && "risk_dif" %in% names(d)) {
    qs <- quantile(d$risk_dif, probs = seq(0, 1, 0.25), na.rm = TRUE)
    qcut <- cut(d$risk_dif, breaks = qs, include.lowest = TRUE,
                labels = c("Neg High","Neg Low","Pos Low","Pos High"))
    d$risk_dif_q <- qcut
  }
  
  # Log-transformed variables
  log_vars <- c(
    # origin & dest core
    "biz_total","biz_total_des",
    "income","income_des",
    "unemp","unemp_des",
    "lfpr","lfpr_des",
    "rent","rent_des",
    "mort","mort_des",
    "price_ave", "price_ave_des",
    "price_ave_5_yr", "price_ave_5_yr_des",
    "price", "price_des",
    "raff","raff_des",
    "oaff","oaff_des",
    "GRP","GRP_des",
    "pop","pop_des",
    "distance",
    # 5-year lags
    "biz_total_5_yr","biz_total_5_yr_des",
    "income_5_yr","income_5_yr_des",
    "unemp_5_yr","unemp_5_yr_des",
    "lfpr_5_yr","lfpr_5_yr_des",
    "rent_5_yr","rent_5_yr_des",
    "mort_5_yr","mort_5_yr_des",
    "raff_5_yr","raff_5_yr_des",
    "oaff_5_yr","oaff_5_yr_des",
    "pop_5_yr","pop_5_yr_des",
    # neighbours (origin)
    "nei_GRP","nei_income","nei_unemp","nei_lfpr",
    "nei_biz_total","nei_rent","nei_mort",
    "nei_raff","nei_oaff",
    "nei_income_5_yr","nei_unemp_5_yr","nei_lfpr_5_yr",
    "nei_biz_total_5_yr","nei_rent_5_yr","nei_mort_5_yr",
    "nei_raff_5_yr","nei_oaff_5_yr",
    # neighbours (dest)
    "nei_GRP_des","nei_income_des","nei_unemp_des","nei_lfpr_des",
    "nei_biz_total_des","nei_rent_des","nei_mort_des",
    "nei_raff_des","nei_oaff_des",
    "nei_income_5_yr_des","nei_unemp_5_yr_des","nei_lfpr_5_yr_des",
    "nei_biz_total_5_yr_des","nei_rent_5_yr_des","nei_mort_5_yr_des",
    "nei_raff_5_yr_des","nei_oaff_5_yr_des"
  )
  
  # Log1p for counts/frequencies & migrant medians
  log1p_vars <- c(
