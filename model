safe_log <- function(x) {
  ifelse(is.finite(x) & !is.na(x) & x > 0, log(x), NA_real_)
}

safe_log1p <- function(x) {
  ifelse(is.finite(x) & !is.na(x) & x >= 0, log1p(x), NA_real_)
}

require_variables <- function(data, vars, model_name) {
  missing_vars <- setdiff(vars, names(data))
  if (length(missing_vars) > 0) {
    stop(
      model_name,
      " cannot be estimated. Missing variable(s): ",
      paste(missing_vars, collapse = ", ")
    )
  }
  invisible(TRUE)
}

