# 9) Price interaction models
# =========================================================
print_interaction_covariance <- function(
    models,
    origin_main,
    origin_interaction,
    destination_main,
    destination_interaction,
    cluster = ~orig_dest_dyad) {

  cat("\n=================================================\n")
  cat("Interaction covariance extraction\n")
  cat("Dyad-clustered standard errors\n")
  cat("=================================================\n")

  for (model_name in names(models)) {
    model <- models[[model_name]]
    covariance_matrix <- stats::vcov(model, cluster = cluster)
    coefficients <- stats::coef(model)

    cat("\nModel:", model_name, "\n")

    print_terms <- function(main_term, interaction_term, label) {
      cat("\n", label, "\n", sep = "")

      if (!all(c(main_term, interaction_term) %in% names(coefficients))) {
        cat("  Term(s) not estimated in this subsample.\n")
        return(invisible(NULL))
      }

      cat("  Main coefficient:", unname(coefficients[main_term]), "\n")
      cat(
        "  Main standard error:",
        sqrt(covariance_matrix[main_term, main_term]),
        "\n"
      )
      cat(
        "  Interaction coefficient:",
        unname(coefficients[interaction_term]),
        "\n"
      )
      cat(
        "  Interaction standard error:",
        sqrt(covariance_matrix[interaction_term, interaction_term]),
        "\n"
      )
      cat(
        "  Covariance:",
        covariance_matrix[main_term, interaction_term],
        "\n"
      )
    }

    print_terms(
      origin_main,
      origin_interaction,
      "Origin housing-price interaction"
    )

    print_terms(
      destination_main,
      destination_interaction,
      "Destination housing-price interaction"
    )
  }
}

